{
  "_meta": {
    "artifact": "Open-Box core wire protocol — failure paths, one per case",
    "capturedFrom": "openbox-core v0.1.337 on the lab box 192.168.2.115",
    "why": "core-golden.json can only express {method, args}, so it cannot reach the boundary itself. These four sentences are user-visible: rpc.mjs throws CoreError(body.error) and the /api handler copies the message into 500 {error}.",
    "order": "trailing data is checked BEFORE protocol; both are checked after the first decode",
    "inputsAreUtf8Text": true,
    "caseCount": 28,
    "warning": "Do not hand-edit. Re-run `node rea-tools/core-protocol.mjs --capture`."
  },
  "cases": [
    {
      "id": "empty",
      "note": "no bytes at all",
      "input": "",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "blank",
      "note": "whitespace only — still no value",
      "input": "   \n",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "not-json",
      "note": "syntax error",
      "input": "not json",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "array",
      "note": "a value, but not an object",
      "input": "[]",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "args-not-array",
      "note": "`args` is an object — the field is array-typed",
      "input": "{\"protocol\":1,\"method\":\"hello\",\"args\":{}}",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "protocol-string",
      "note": "`protocol` is a string",
      "input": "{\"protocol\":\"1\",\"method\":\"hello\",\"args\":[]}",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "protocol-float",
      "note": "`protocol` is a float — Go will not narrow 1.0 into an int field",
      "input": "{\"protocol\":1.0,\"method\":\"hello\",\"args\":[]}",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "license-number",
      "note": "`license` is a number",
      "input": "{\"protocol\":1,\"method\":\"hello\",\"args\":[],\"license\":123}",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "geotags-string",
      "note": "`geoTags` is a string",
      "input": "{\"protocol\":1,\"method\":\"hello\",\"args\":[],\"geoTags\":\"cn\"}",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "bom",
      "note": "a UTF-8 BOM is not JSON whitespace",
      "input": "﻿{\"protocol\":1,\"method\":\"hello\",\"args\":[]}",
      "exit": 0,
      "stdout": "{\"error\":\"invalid native-core request\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "two-objects",
      "note": "two values",
      "input": "{\"protocol\":1,\"method\":\"hello\",\"args\":[]}{\"protocol\":1,\"method\":\"hello\",\"args\":[]}",
      "exit": 0,
      "stdout": "{\"error\":\"trailing native-core request data\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "trailing-garbage",
      "note": "one value plus junk",
      "input": "{\"protocol\":1,\"method\":\"hello\",\"args\":[]} trailing",
      "exit": 0,
      "stdout": "{\"error\":\"trailing native-core request data\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "proto2-plus-trailing",
      "note": "wrong protocol *and* trailing — answers trailing, which fixes the order",
      "input": "{\"protocol\":2,\"method\":\"hello\",\"args\":[]}{\"x\":1}",
      "exit": 0,
      "stdout": "{\"error\":\"trailing native-core request data\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "null",
      "note": "decodes into the zero request, so protocol 0",
      "input": "null",
      "exit": 0,
      "stdout": "{\"error\":\"native-core protocol mismatch\",\"ok\":false,\"protocol\":1}\n"
    },
    {
      "id": "object-no-method",
