#!/bin/sh /etc/rc.common
# OpenWrt procd init script for the openbox-oss panel (Flask).
# The panel owns the kernel (autostart on boot); the kernel procd
# script (openbox-oss.init) is only a fallback for running sing-box
# standalone. Data lives in $PREFIX/var (panel.db, config.json,
# geodata, dns-filter).
START=99
STOP=10
USE_PROCD=1
PREFIX="${OBX_PREFIX:-/opt/openbox-oss}"

start_service() {
  procd_open_instance openbox-oss-panel
  procd_set_param command "$PREFIX/venv/bin/python" "$PREFIX/panel/panel/run.py"
  procd_set_param env OBX_DB="$PREFIX/var/panel.db" \
    OPENBOX_WORKDIR="$PREFIX/var" PORT=8081 \
    OBX_CORE_BIN="$PREFIX/bin/oss-core" OBX_TRAFFIC_COLLECT=1
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param respawn 3600 5 0
  procd_close_instance
}
